enum Theme { light, dark }
export component SideSwitch {
    property <Theme> theme: Theme.light;

    frame := Rectangle {
        background: #222222;
        border-radius: self.height / 2;
    }

    frameBacker := Rectangle {
        width: parent.width;
        height: parent.height;
        background: transparent;
        border-radius: self.height / 2;
    }

    sun := Rectangle {
        x: parent.height * 0.3;
        width: parent.height * 0.5;
        height: parent.height * 0.5;
        background: #ff0000;
        border-radius: parent.height * 0.1;
    }

    moon := Rectangle {
        x: parent.width - self.width - parent.height * 0.3;
        width: parent.height * 0.5;
        height: parent.height * 0.5;
        background: #0000FF;
        border-radius: parent.height * 0.1;
    }

    thumb := Rectangle {
        y: (parent.height - self.height) / 2;
        width: parent.width * 0.4;
        height: self.width;
        border-radius: self.width / 2;

        drop-shadow-offset-x: 3px;
        drop-shadow-offset-y: 3px;
        drop-shadow-color: black.transparentize(30%);
        drop-shadow-blur: 10px;
    }

    TouchArea {
        clicked => {
            if root.theme == Theme.light {
                root.theme = Theme.dark;
            } else {
                root.theme = Theme.light;
            }
        }
    }

    states [
        darkMode when root.theme == Theme.dark: {
            thumb.x: thumb.y;
            thumb.background: @radial-gradient(circle,#b0b0b0 0%, #cccccc 70%, #e9e9e9 100%);
            frameBacker.background: #2A2A2A;
            moon.transform-rotation: -20deg;
            sun.transform-rotation: -20deg;
            sun.transform-scale: 0.8;
            moon.transform-scale: 1;
            in {
                animate thumb.x, thumb.background, frameBacker.background {
                    duration: 200ms;
                    easing: ease-out-sine;
                }
                animate sun.transform-rotation, sun.transform-scale, moon.transform-rotation, moon.transform-scale {
                    duration: 1200ms;
                    easing: ease-out-elastic;
                }
            }

        }
        lightMode when root.theme == Theme.light: {
            thumb.x: frame.width - thumb.width - thumb.y;
            thumb.background: @radial-gradient(circle,#b0b0b0 0%, #cccccc 70%, #e9e9e9 100%);
            frameBacker.background: transparent;
            moon.transform-rotation: 20deg;
            sun.transform-rotation: 20deg;
            sun.transform-scale: 1;
            moon.transform-scale: 0.8;
            in {
                animate thumb.x, thumb.background, frameBacker.background, moon.transform-rotation {
                    duration: 200ms;
                    easing: ease-out-sine;
                }
                animate sun.transform-rotation, sun.transform-scale, moon.transform-rotation, moon.transform-scale {
                    duration: 1200ms;
                    easing: ease-out-elastic;
                }
            }
        }
    ]
}