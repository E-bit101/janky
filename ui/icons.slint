export component XIcon inherits Rectangle {
    width: 24px;
    height: 24px;
    background: transparent;

    Text { text: "X"; color: red; font-size: 30pt;
    font-weight: FontWeight.extra-bold; }
}

export component CheckIcon inherits Rectangle {
    width: 24px;
    height: 24px;
    background: transparent;

    Text { text: "✓"; color: green; font-size: 30pt;
    font-weight: FontWeight.extra-bold; }
}